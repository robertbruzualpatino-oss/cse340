<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    <ul>
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(org => { %>
                <li>
                    <img src="/images/<%= org.logo_filename || 'default-logo.png' %>" alt="<%= org.name %> logo">
                    <strong><%= org.name %>:</strong> <%= org.contact_email %>
                </li>
            <% }) %>
        <% } else { %>
             <p>No partner organizations available at this time.</p>
        <% } %>
    </ul>
</main>
<%- include('partials/footer') %>