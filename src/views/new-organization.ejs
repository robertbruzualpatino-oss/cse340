<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-error"><%= error %></p>
    <% } %>

    <form action="/new-organization" method="POST">
        <div class="form-group">
            <label for="name">Organization Name</label>
            <input 
                type="text"
                id="name"
                name="name"
                value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
                required
                minlength="2"
                maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea 
                id="description"
                name="description"
                required
                minlength="5"
                maxlength="1000"
            ><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email</label>
            <input 
                type="email"
                id="contactEmail"
                name="contactEmail"
                value="<%= typeof formData !== 'undefined' && formData.contactEmail ? formData.contactEmail : '' %>"
                required
                maxlength="255"
            />
        </div>

        <button type="submit">Create Organization</button>
    </form>

</main>
<%- include('partials/footer') %>