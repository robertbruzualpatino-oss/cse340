<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>

    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <%
                    // Format the event date cleanly
                    const formattedDate = new Date(project.event_date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        timeZone: 'UTC'
                    });
                %>
                <li>
                    <strong><%= formattedDate %>:</strong> <%= project.title %> (<%= project.organization_name %>)
                </li>
            <% }); %>
        </ul>
   <% } else { %>
        <p>No service projects available at this time.</p>
   <% } %>
</main>

<%- include('partials/footer') %>